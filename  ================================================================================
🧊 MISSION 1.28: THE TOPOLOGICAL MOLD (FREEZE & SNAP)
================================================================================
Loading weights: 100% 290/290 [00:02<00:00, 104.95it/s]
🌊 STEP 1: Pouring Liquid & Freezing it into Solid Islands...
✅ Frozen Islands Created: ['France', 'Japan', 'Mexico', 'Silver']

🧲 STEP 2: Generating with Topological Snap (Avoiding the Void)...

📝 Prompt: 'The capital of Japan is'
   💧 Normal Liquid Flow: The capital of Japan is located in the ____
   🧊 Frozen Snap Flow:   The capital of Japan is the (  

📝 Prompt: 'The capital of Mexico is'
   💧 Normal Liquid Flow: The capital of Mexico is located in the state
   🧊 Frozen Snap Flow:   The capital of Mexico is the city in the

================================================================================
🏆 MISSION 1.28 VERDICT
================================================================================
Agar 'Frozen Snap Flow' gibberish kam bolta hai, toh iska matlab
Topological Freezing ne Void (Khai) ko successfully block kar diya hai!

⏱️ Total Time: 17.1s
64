# 1. Load Model
model = AutoModelForCausalLM.from_pretrained("Qwen/Qwen2.5-0.5B-Instruct", dtype=torch.float32, low_cpu_mem_usage=True)
tok = AutoTokenizer.from_pretrained("Qwen/Qwen2.5-0.5B-Instruct")
if tok.pad_token is None: tok.pad_token = tok.eos_token
model.eval()
NL = model.config.num_hidden_layers

# 2. STEP A: POUR THE LIQUID & FREEZE IT (Creating the Topological Mold)
print("\n🌊 STEP 1: Pouring Liquid & Freezing it into Solid Islands...")
concepts = ["France", "Japan", "Mexico", "Silver"]
frozen_islands = {}

for concept in concepts:
    prompt = f"The capital of {concept} is"
    ids = tok(prompt, return_tensors="pt").input_ids
    
    with torch.no_grad():
        out = model(ids, output_hidden_states=True)
        
    # Freeze the final hidden state (The Shape of the Island)
    h = out.hidden_states[-1][0, -1, :].float()
    frozen_islands[concept] = h

print(f"✅ Frozen Islands Created: {list(frozen_islands.keys())}")

# 3. STEP B: GENERATION WITH "MAGNETIC SNAP"
print("\n🧲 STEP 2: Generating with Topological Snap (Avoiding the Void)...")

# The Hook: If the model falls into the Void, SNAP it to the nearest Island
STATE = {"snap": False}

def make_snap_hook(l_idx):
    def hook(m, i, o):
        if not STATE["snap"]: return o
        if l_idx != NL - 1: return o # Only snap at the very last layer
        
        x = o.clone()
        h = x[0, -1, :].float() # Last token hidden state
        
        # Check distance to all Frozen Islands
        min_dist = 1e9
        nearest_island = None
        
        for name, island_h in frozen_islands.items():
            dist = (h - island_h).norm().item()
            if dist < min_dist:
                min_dist = dist
                nearest_island = island_h
                
        # THE SNAP: Pull the state 20% towards the nearest Frozen Island
        # This prevents the "liquid" from falling into the Void!
        SNAP_STRENGTH = 0.2 
        h_snapped = h + SNAP_STRENGTH * (nearest_island - h)
        
        x[0, -1, :] = h_snapped.to(o.dtype)
        return x
    return hook

snap_hooks = [model.model.layers[l].register_forward_hook(make_snap_hook(l)) for l in range(NL)]

# 4. TEST GENERATION
test_prompts = ["The capital of Japan is", "The capital of Mexico is"]

for prompt in test_prompts:
    ids = tok(prompt, return_tensors="pt").input_ids
    
    # Without Snap (Normal Liquid Flow)
    STATE["snap"] = False
    with torch.no_grad():
        out_normal = model.generate(ids, max_new_tokens=4, do_sample=False)
    text_normal = tok.decode(out_normal[0], skip_special_tokens=True)
    
    # With Snap (Frozen Topology Guidance)
    STATE["snap"] = True
    with torch.no_grad():
        out_snapped = model.generate(ids, max_new_tokens=4, do_sample=False)
    text_snapped = tok.decode(out_snapped[0], skip_special_tokens=True)
    
    print(f"\n📝 Prompt: '{prompt}'")
    print(f"   💧 Normal Liquid Flow: {text_normal}")
    print(f"   🧊 Frozen Snap Flow:   {text_snapped}")

for h in snap_hooks: h.remove()

