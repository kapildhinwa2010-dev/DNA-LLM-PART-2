if tok.pad_token is None: tok.pad_token = tok.eos_token
model.eval()

# 2. The SLERP Math Function (The Bridge Builder)
def slerp(val, v1, v2):
    """Spherical Linear Interpolation - Stays on the surface of the manifold"""
    v1_n = v1 / v1.norm(dim=-1, keepdim=True)
    v2_n = v2 / v2.norm(dim=-1, keepdim=True)
    
    dot = (v1_n * v2_n).sum(dim=-1, keepdim=True)
    dot = torch.clamp(dot, -1.0, 1.0)
    omega = torch.acos(dot)
    sin_omega = torch.sin(omega)
    
    # Fallback to LERP if vectors are almost identical (avoid div by zero)
    mask = (sin_omega < 1e-5).float()
    t = torch.tensor(val, dtype=v1.dtype).view(1, 1, 1)
    
    term1 = torch.sin((1.0 - t) * omega) / (sin_omega + 1e-9)
    term2 = torch.sin(t * omega) / (sin_omega + 1e-9)
    
    slerp_vec = term1 * v1 + term2 * v2
    lerp_vec = (1.0 - t) * v1 + t * v2
    
    return mask * lerp_vec + (1.0 - mask) * slerp_vec

# 3. Setup Embeddings
